# App développeur X (portail dev, OAuth 2.0 activé, type "confidential" ou "public")
X_CLIENT_ID=
# Laisser vide pour un client public (PKCE seul)
X_CLIENT_SECRET=

# Clé Fernet chiffrant state/token.enc (générée par scripts/authorize.py au premier run)
TOKEN_ENC_KEY=

# Extraction de savoir
ANTHROPIC_API_KEY=
# Optionnel
CLAUDE_MODEL=claude-sonnet-5
